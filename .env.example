# Copy to .env and adjust. Only API_URL is required.

# URL the worker polls for alert data.
API_URL=https://example.com/alerts

# How often (seconds) the worker refreshes the cached data.
UPDATE_INTERVAL=10

# Timeout (seconds) for each upstream fetch.
REQUEST_TIMEOUT=10

# How to reach Redis for the cached data and the Celery broker. Override to use
# a different host/port, a password-protected or TLS (rediss://) server, or a
# managed Redis instance, e.g. rediss://:password@my-redis.example.com:6380/0
REDIS_URL=redis://redis:6379/0

# Storage for the rate limiter. Defaults to db 1 of REDIS_URL when unset; set it
# explicitly for managed Redis that exposes only a single database.
# RATELIMIT_REDIS_URL=redis://redis:6379/1

# Memory cap for the bundled Redis container (docker-compose).
REDIS_MAXMEMORY=256mb
